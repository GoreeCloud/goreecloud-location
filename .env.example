# GoreeCloud Location local-development environment template.
# Copy to .env locally and provide real secrets outside Git history.

LOCATION_API_ADDRESS=:8080

# Database connectivity is introduced when the API persistence milestone lands.
# Values below document the intended variable names only.
LOCATION_DATABASE_HOST=localhost
LOCATION_DATABASE_PORT=5432
LOCATION_DATABASE_NAME=goreecloud_location
LOCATION_DATABASE_USER=goreecloud_location
LOCATION_DATABASE_PASSWORD=replace-locally
LOCATION_DATABASE_SSLMODE=disable
